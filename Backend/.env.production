# PayFlow Backend - Production Environment Configuration

# ============ APPLICATION ============
NODE_ENV=production
PORT=8001
APP_URL=https://payflow.vercel.app
API_URL=https://payflow-backend.up.railway.app

# ============ DATABASE ============
# Use Neon PostgreSQL (serverless, free tier available)
# Get from: https://console.neon.tech/
DATABASE_URL=${NEON_DATABASE_URL}

# ============ AUTHENTICATION ============
# Generate secure JWT secret: openssl rand -base64 64
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d

# ============ AI ============
# Get Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=${GEMINI_API_KEY}

# ============ BLOCKCHAIN ============
# Use Alchemy for reliable RPC
# Get from: https://dashboard.alchemy.com/
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ETHEREUM_NETWORK=sepolia

# Contract addresses (update after deployment)
PAYFLOW_ESCROW_ADDRESS=${PAYFLOW_ESCROW_ADDRESS}
MNEE_TOKEN_ADDRESS=0x8ccedbAe4916b79da7F3F612EfB2EB93A2bFD6cF

# ============ WEBHOOKS ============
# Generate secure webhook secret: openssl rand -base64 32
WEBHOOK_SECRET=${WEBHOOK_SECRET}

# ============ CORS ============
# Allow frontend domain
CORS_ORIGIN=https://payflow.vercel.app

# ============ OPTIONAL ============
# Monitoring & Logging
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=info
